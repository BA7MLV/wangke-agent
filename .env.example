APP_VERSION=0.1.0
WANGKE_IMAGE=wangke-agent:0.1.0
PORT=3000
WANGKE_BIND_HOST=0.0.0.0
HOST=0.0.0.0
DATA_DIR=/data
DB_PATH=/data/db/wangke.sqlite
BOOTSTRAP_SECRET_FILE=/data/config/bootstrap-secret
BOOTSTRAP_TTL_MS=900000
PUBLIC_ORIGIN=http://localhost:3000
WEBAUTHN_RP_ID=localhost
WEBAUTHN_RP_NAME=Wangke Agent
# Bot model credentials stay in the API container; never put these in frontend code.
MODEL_BASE_URL=https://api.openai.com/v1
MODEL_API_KEY=
MODEL_NAME=gpt-4o-mini
MODEL_TIMEOUT_MS=30000
# File API limit in bytes (upper bound 512 MiB). Same default as compose.yaml and install.sh.
MAX_FILE_BYTES=536870912
FILES_DIR=/data/files
CLOUD_CONCURRENCY=2

# ── 前后端分离（见 docs/deployment.md）──
# 浏览器前端在别的域名时，列出它的 origin（逗号分隔）。同源部署留空。
CORS_ORIGINS=
# 前端和 API 不在同一个注册域时设为 none（要求 PUBLIC_ORIGIN 是 https）。
COOKIE_SAMESITE=lax
# 原生壳层 Bearer token 的有效期（毫秒），默认 90 天。
TOKEN_TTL_MS=7776000000
# 只跑 API、不托管前端时设为 false（compose.split.yaml 已经这么设了）。
SERVE_WEB=true
# compose.prod.yaml 用：公网域名，Caddy 自动申请证书。
# DOMAIN=agent.example.com

# Linux Docker operations are handled by scripts/wangke-agent. Keep this file
# free of real credentials when copying it into a repository or ticket.
