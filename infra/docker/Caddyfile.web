{
	admin off
}

:8080 {
	root * /srv

	# API traffic belongs to the stable edge, never the replaceable Web container.
	handle /api/* {
		respond "not_found" 404
	}
	# Keep chunk failures distinguishable from the SPA fallback.
	handle /assets/* {
		header Cache-Control "public, max-age=31536000, immutable"
		header X-Content-Type-Options nosniff
		file_server
	}

	handle {
		# 和一体化镜像一致的隔离头：VAD / 转写用到 SharedArrayBuffer。
		header {
			Cross-Origin-Opener-Policy same-origin
			Cross-Origin-Embedder-Policy require-corp
			X-Content-Type-Options nosniff
			Referrer-Policy no-referrer
		}
		@config path /config.js /sw.js /index.html /
		header @config Cache-Control "no-cache"
		encode zstd gzip
		try_files {path} /index.html
		file_server
	}
}
