{
  "name": "wangke-agent",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "apps/api",
    "apps/web",
    "packages/contracts",
    "packages/study-core"
  ],
  "license": "GPL-2.0-only",
  "type": "module",
  "packageManager": "npm@11.16.0",
  "scripts": {
    "predev": "turbo run build --filter=@wangke/contracts --filter=@wangke/study-core",
    "dev": "npm run dev -w @wangke/web",
    "build": "npm run check:boundaries && turbo run build",
    "build:web": "npm run check:boundaries && turbo run build --filter=@wangke/web",
    "build:api": "npm run check:boundaries && turbo run build --filter=@wangke/api",
    "generate:models": "node scripts/generate-models.mjs",
    "predev:api": "npm run build:api",
    "dev:api": "npm run dev -w @wangke/api",
    "start": "npm run start -w @wangke/api",
    "reset:password": "node scripts/reset-password.mjs",
    "test:password": "tsx scripts/test-password-auth.mjs",
    "test:reset": "tsx scripts/test-account-reset.mjs",
    "test:install": "node --test scripts/test-install-progress.mjs scripts/test-web-update.mjs",
    "test:api": "tsx scripts/test-api.mjs",
    "test:api-split": "tsx scripts/test-api-split.mjs",
    "test:migration": "node scripts/test-migration.mjs",
    "test:bot": "tsx scripts/test-bot-runtime.mjs && tsx scripts/test-bot-conversation.mjs && tsx scripts/test-bot-permissions.mjs",
    "test:system-files": "tsx scripts/test-system-files.mjs && tsx scripts/test-notebook-tools.mjs && tsx scripts/test-agent-instructions.mjs",
    "test:memory-context": "tsx scripts/test-memory-context.mjs",
    "test:system-files:e2e": "tsx scripts/e2e-system-files.mjs",
    "test:projects": "tsx scripts/test-projects.mjs",
    "test:resources": "tsx scripts/test-resource-folders.mjs",
    "test:resources:e2e": "tsx scripts/e2e-resource-folders.mjs",
    "test:projects:e2e": "tsx scripts/test-projects-e2e.mjs",
    "test:bot:hardening": "tsx scripts/test-bot-migrations.mjs && tsx scripts/test-bot-hardening.mjs && tsx scripts/test-bot-services.mjs && tsx scripts/test-bot-domain.mjs && tsx scripts/test-bot-lifecycle.mjs && tsx scripts/test-bot-request-budget.mjs && tsx scripts/test-gateway-retention.mjs",
    "test:bot:management": "tsx scripts/e2e-bot-management.mjs",
    "eval:bot": "npm run build:api && tsx scripts/eval-bot.mjs",
    "test:gateway": "tsx scripts/test-gateway.mjs && tsx scripts/test-gateway-review.mjs",
    "test:gateway:ui": "tsx scripts/e2e-gateway.mjs",
    "test:mcp": "tsx scripts/test-mcp.mjs && tsx scripts/test-mcp-compat.mjs",
    "test:sandbox": "node scripts/test-sandbox.mjs",
    "test:cloud": "tsx scripts/test-cloud.mjs",
    "test:model-settings": "tsx scripts/test-model-configuration.mjs && tsx scripts/test-cloud-model-settings.mjs && tsx --test scripts/test-model-discovery.test.ts",
    "test:model-settings:e2e": "tsx scripts/test-cloud-models-e2e.mjs",
    "test:tasks": "npm run build:api && tsx scripts/test-task-executors.mjs",
    "test:browser-worker": "tsx scripts/test-browser-worker.mjs",
    "test:cloud:e2e": "tsx scripts/test-cloud-e2e.mjs",
    "test:cloud:files": "tsx scripts/test-cloud-files.mjs",
    "test:cloud:backup": "tsx scripts/test-cloud-backup.mjs",
    "test:wrongbook": "tsx --test scripts/test-wrongbook.mjs",
    "test:ime": "tsx --test scripts/test-ime-enter.mjs",
    "test:bot-ui": "tsx --test scripts/test-bot-messages.mjs",
    "test:onboarding": "tsx --test scripts/test-onboarding.mjs",
    "check:boundaries": "node scripts/check-boundaries.mjs",
    "test:boundaries": "node scripts/test-boundaries.mjs",
    "test:release-drain": "tsx scripts/test-release-drain.mjs && tsx scripts/test-server-drain.mjs && node scripts/test-api-signals.mjs",
    "test:release-recovery": "npm run build:api && tsx --test scripts/test-release-recovery.mjs scripts/test-release-docker.mjs && tsx scripts/test-release-staging.mjs",
    "test:release-plan": "node scripts/test-release-plan.mjs",
    "verify:api-isolation": "node scripts/verify-api-isolation.mjs",
    "verify:web-isolation": "node scripts/verify-web-isolation.mjs",
    "check:i18n": "npm run check:i18n -w @wangke/web",
    "test:i18n": "npm run check:i18n && tsx --test scripts/test-i18n.mjs",
    "test:i18n:e2e": "node scripts/e2e-i18n.mjs",
    "preview": "npm run preview -w @wangke/web"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "esbuild": "^0.21.5",
    "fake-indexeddb": "^6.2.5",
    "playwright": "^1.63.0",
    "tsx": "^4.23.15",
    "turbo": "2.11.10",
    "typescript": "^5.9.3",
    "ws": "^8.22.0"
  },
  "allowScripts": {
    "esbuild@0.21.5": true,
    "protobufjs@7.6.6": true
  }
}
