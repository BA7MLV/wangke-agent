{
  "name": "wangke-agent",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "apps/api",
    "packages/contracts"
  ],
  "license": "GPL-2.0-only",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "npm run check:i18n && npm run build:api && tsc -b && vite build",
    "build:api": "tsc -p tsconfig.api.json && tsc -p tsconfig.runtime.json && node scripts/build-task-runtime.mjs",
    "dev:api": "tsx apps/api/src/server.ts",
    "start": "node dist-api/apps/api/src/server.js",
    "test:api": "tsx scripts/test-api.mjs",
    "test:migration": "node scripts/test-migration.mjs",
    "test:bot": "tsx scripts/test-bot-runtime.mjs",
    "test:sandbox": "node scripts/test-sandbox.mjs",
    "test:cloud": "tsx scripts/test-cloud.mjs",
    "test:tasks": "npm run build:api && tsx scripts/test-task-executors.mjs",
    "test:cloud:e2e": "tsx scripts/test-cloud-e2e.mjs",
    "test:cloud:files": "tsx scripts/test-cloud-files.mjs",
    "test:cloud:backup": "tsx scripts/test-cloud-backup.mjs",
    "test:wrongbook": "tsx --test scripts/test-wrongbook.mjs",
    "test:ime": "tsx --test scripts/test-ime-enter.mjs",
    "test:bot-ui": "tsx --test scripts/test-bot-messages.mjs",
    "check:i18n": "node scripts/check-i18n.mjs",
    "test:i18n": "npm run check:i18n && tsx --test scripts/test-i18n.mjs",
    "test:i18n:e2e": "node scripts/e2e-i18n.mjs",
    "preview": "vite preview --host"
  },
  "dependencies": {
    "@ant-design/x-markdown": "^2.9.0",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-markdown": "^6.5.2",
    "@dagrejs/dagre": "^3.1.1",
    "@fastify/helmet": "^13.2.0",
    "@fastify/static": "^8.3.0",
    "@fontsource/roboto": "^5.3.0",
    "@heroui/react": "^3.2.6",
    "@heroui/styles": "^3.2.6",
    "@lezer/markdown": "^1.7.2",
    "@ricky0123/vad-web": "^0.0.30",
    "@simplewebauthn/browser": "^13.3.0",
    "@simplewebauthn/server": "^13.2.2",
    "@tabler/icons-react": "^3.49.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-virtual": "^3.14.21",
    "@vidstack/react": "^1.15.6",
    "argon2": "^0.44.0",
    "better-sqlite3": "^12.11.1",
    "chart.js": "^4.5.1",
    "codemirror": "^6.0.2",
    "dayjs": "^1.11.23",
    "dexie": "^4.4.5",
    "docx": "^8.5.0",
    "docx-preview": "^0.4.0",
    "dompurify": "^3.4.15",
    "fastify": "^5.12.7",
    "fflate": "^0.8.3",
    "html-to-image": "^1.11.13",
    "i18next": "^26.5.5",
    "katex": "^0.16.47",
    "marked": "^15.0.12",
    "mediabunny": "^1.55.7",
    "mermaid": "^11.17.2",
    "onnxruntime-web": "^1.29.0",
    "pdfjs-dist": "^4.10.38",
    "perfect-freehand": "^1.2.3",
    "playwright": "^1.63.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-i18next": "^17.1.1",
    "react-router-dom": "^6.30.6",
    "sql.js": "^1.14.2",
    "tailwind-variants": "^3.3.1",
    "tailwindcss": "^4.3.3",
    "ts-fsrs": "^5.4.2",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^20.19.43",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/sql.js": "^1.4.11",
    "@vitejs/plugin-react": "^4.7.0",
    "esbuild": "^0.21.5",
    "fake-indexeddb": "^6.2.5",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite": "^5.4.21",
    "vite-plugin-pwa": "^0.20.5",
    "ws": "^8.22.0"
  },
  "allowScripts": {
    "esbuild@0.21.5": true,
    "protobufjs@7.6.6": true
  }
}
