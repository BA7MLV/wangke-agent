#!/usr/bin/env bash
set -euo pipefail

DATA_DIR="${WANGKE_DATA_DIR:-${HOME:?}/.wangke-agent}"
DEFAULT_COMPOSE_FILE="${WANGKE_DEFAULT_COMPOSE_FILE:-__DEFAULT_COMPOSE_FILE__}"
COMPOSE_FILE="${WANGKE_COMPOSE_FILE:-$DEFAULT_COMPOSE_FILE}"
SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
usage() { echo "Usage: wangke-agent [--data-dir DIR] [--compose-file FILE] {status|logs|stop|start|restart|update|backup} [args...]"; }
while [ "$#" -gt 0 ]; do
  case "$1" in
    --data-dir) DATA_DIR=$2; shift 2;;
    --compose-file) COMPOSE_FILE=$2; shift 2;;
    -h|--help) usage; exit 0;;
    *) break;;
  esac
done
command=${1:-}; [ -n "$command" ] && shift || { usage >&2; exit 2; }
[ -n "$COMPOSE_FILE" ] && [ -f "$COMPOSE_FILE" ] || { echo "compose file is not configured or missing" >&2; exit 1; }
[ -f "$DATA_DIR/.env" ] || { echo "missing $DATA_DIR/.env" >&2; exit 1; }
EXTRA=()
# 安装时用了 --domain，就一直带上 compose.prod.yaml；以前 update/restart 会把 Caddy 和
# 生产环境的必填校验一起丢掉，HTTPS 入口在第一次 update 后就消失了。
if grep -q '^DOMAIN=.' "$DATA_DIR/.env"; then
  EXTRA+=(-f "$(dirname "$COMPOSE_FILE")/compose.prod.yaml")
fi
if grep -q '^SANDBOX_TOKEN=' "$DATA_DIR/.env"; then
  EXTRA+=(-f "$(dirname "$COMPOSE_FILE")/compose.agent.yaml")
fi
compose() { WANGKE_HOST_DATA_DIR="$DATA_DIR/data" WANGKE_UID="$(id -u)" WANGKE_GID="$(id -g)" docker compose --env-file "$DATA_DIR/.env" -f "$COMPOSE_FILE" ${EXTRA[@]+"${EXTRA[@]}"} "$@"; }
case "$command" in
  status) compose ps "$@";;
  logs) compose logs "$@";;
  stop|start|restart) compose "$command" "$@";;
  update)
    "$SCRIPT_DIR/backup.sh" --data-dir "$DATA_DIR" --compose-file "$COMPOSE_FILE" >/dev/null
    if grep -q '^SANDBOX_TOKEN=' "$DATA_DIR/.env"; then
      docker build -t wangke-sandbox:0.1.0 -f "$(dirname "$COMPOSE_FILE")/infra/sandbox/Dockerfile" "$(dirname "$COMPOSE_FILE")"
    fi
    compose up -d --build "$@"
    ;;
  backup) "$SCRIPT_DIR/backup.sh" --data-dir "$DATA_DIR" --compose-file "$COMPOSE_FILE" "$@";;
  *) usage >&2; exit 2;;
esac
